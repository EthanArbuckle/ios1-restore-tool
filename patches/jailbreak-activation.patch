+int lockdownd_set_value_bool(mux_session_t *session, const char *key, int value, char *error_out, size_t error_out_sz) {
+    if (!session || !key) {
+        return 0;
+    }
+    if (error_out && error_out_sz) {
+        error_out[0] = '\0';
+    }
+
+    CFMutableDictionaryRef req = lockdownd_create_request("SetValue");
+    if (!req) {
+        return 0;
+    }
+    plist_dict_set_string(req, "Key", key);
+    plist_dict_set_bool(req, "Value", value != 0);
+
+    CFDictionaryRef resp = NULL;
+    int ok = lockdownd_exchange_plist(session, req, &resp);
+    CFRelease(req);
+    if (!ok || !resp) {
+        return 0;
+    }
+
+    char result[64] = {0};
+    plist_dict_get_string(resp, "Result", result, sizeof(result));
+    if (error_out && error_out_sz) {
+        plist_dict_get_string(resp, "Error", error_out, error_out_sz);
+    }
+    ok = strcmp(result, "Success") == 0;
+    CFRelease(resp);
+    return ok;
+}
